{
    "name": "prestashop/creditjet",
    "description": "PB Personal Finance Credit Calculator",
    "license": "AFL-3.0",
    "authors": [
      {
        "name": "Ilko Ivanov",
        "email": "ilko.iv@gmail.com"
      }
    ],
    "autoload": {
      "psr-4": {
        "PrestaShop\\Module\\CreditJet\\": "src/"
      }
    },
    "require": {
      "php": ">=8.1"
    },
    "require-dev": {
      "prestashop/php-dev-tools": "^5.0",
        "cyclonedx/cyclonedx-php-composer": "^6.2"
    },
    "config": {
      "preferred-install": "dist",
      "prepend-autoloader": false,
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "extra": {
      "prestashop": {
        "installer": {
          "path": "modules/creditjet"
        }
      }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "type": "prestashop-module"
  }
